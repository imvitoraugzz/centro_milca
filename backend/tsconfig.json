{
  "compilerOptions": {
    /* Layout do Projeto */
    "rootDir": "./src",                          // Onde estará todo seu código TS
    "outDir": "./dist",                          // Onde o código compilado JS vai cair

    /* Configurações de Ambiente */
    "target": "ES2022",                          // Versão do JS moderno no Node.js
    "module": "NodeNext",                        // Mantém compatibilidade moderna nativa
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,                     // Permite importar pacotes CommonJS antigos com 'import'

    /* Qualidade e Segurança do Código */
    "strict": true,                              // Ativa checagem estrita de tipos (evita bugs de 'undefined')
    "skipLibCheck": true,                        // Ignora checagem de erros dentro de node_modules (ganha velocidade)
    "forceConsistentCasingInFileNames": true     // Evita problemas de maiúsculas/minúsculas entre Windows e Linux
  },
  "include": ["src/**/*"]                        // Diz ao TS para monitorar apenas a pasta src
}